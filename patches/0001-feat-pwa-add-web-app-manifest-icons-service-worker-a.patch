+    
+    <!-- Subtle Tech Pattern / Accent Lines -->
+    <path d="M 40 40 L 100 40 M 200 40 L 260 40 M 260 100 L 260 160 M 40 200 L 40 260 M 200 260 L 260 260" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-opacity="0.3" fill="none" />
