+  <rect width="512" height="512" rx="112" fill="url(#bgGrad)" />
+  <rect width="504" height="504" x="4" y="4" rx="108" fill="none" stroke="url(#borderGrad)" stroke-width="4" />
+
+  <!-- Central Glow & Emblem Badge -->
+  <g transform="translate(106, 106)">
