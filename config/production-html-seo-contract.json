{
  "phase": "39E",
  "scope": "production-spa-shell-and-client-seo-reliability",
  "production_origin": "https://jawed.co.in",
  "max_redirects": 0,
  "max_body_bytes": 1000000,
  "root_check": {
    "path": "/",
    "canonical": "https://jawed.co.in/",
    "required": [
      "<title>",
      "<meta name=\"description\"",
      "<link rel=\"canonical\" href=\"https://jawed.co.in/\">",
      "<meta property=\"og:url\" content=\"https://jawed.co.in/\">",
      "<meta name=\"twitter:card\""
    ],
    "forbidden": [
      "noindex"
    ]
  },
  "route_shells": [
    "/about/",
    "/ai/",
    "/notes/",
    "/work/",
    "/topics/",
    "/work/projects/",
    "/work/experience/",
    "/work/skills/",
    "/privacy/",
    "/tools/",
    "/blog/",
    "/resources/",
    "/contact/"
  ],
  "route_shell_required": [
    "<div id=\"root\"></div>",
    "/assets/index-"
  ]
}
