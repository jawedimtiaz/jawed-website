{
  "phase": "38P",
  "scope": "production-static-asset-reliability",
  "production_origin": "https://jawed.co.in",
  "max_redirects": 0,
  "max_body_bytes": 500000,
  "checks": [
    {
      "path": "/favicon.svg",
      "status": 200,
      "content_type": "image/svg+xml",
      "min_body_bytes": 100
    },
    {
      "path": "/favicon.ico",
      "status": 200,
      "content_type": "image/",
      "min_body_bytes": 100
    },
    {
      "path": "/manifest.webmanifest",
      "status": 200,
      "content_type": "application/",
      "min_body_bytes": 100
    },
    {
      "path": "/assets/images/social-preview.png",
      "status": 200,
      "content_type": "image/png",
      "min_body_bytes": 10000
    },
    {
      "path": "/sw.js",
      "status": 200,
      "content_type": "javascript",
      "min_body_bytes": 1000
    }
  ]
}
