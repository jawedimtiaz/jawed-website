{
  "phase": "38R",
  "scope": "production-cache-reliability",
  "production_origin": "https://jawed.co.in",
  "max_redirects": 0,
  "checks": [
    {
      "path": "/assets/images/social-preview.png",
      "require_cache_control": true,
      "cache_policy": "public"
    },
    {
      "path": "/favicon.svg",
      "require_cache_control": true,
      "cache_policy": "public"
    },
    {
      "path": "/favicon.ico",
      "require_cache_control": true,
      "cache_policy": "public"
    },
    {
      "path": "/manifest.webmanifest",
      "require_cache_control": true,
      "cache_policy": "public"
    }
  ],
  "discover_vite_assets_from_homepage": true
}
